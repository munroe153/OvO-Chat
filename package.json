{
  "name": "ovo-chat",
  "version": "0.1.2",
  "description": "Mobile-friendly DeepSeek chat with branching conversations, web search, read-only vault tools, and chart rendering.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "check": "tsc -noEmit -skipLibCheck",
    "lint": "eslint .",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "package": "node esbuild.config.mjs production && zip -r ovo-chat-$npm_package_version.zip main.js manifest.json styles.css"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "deepseek",
    "chat",
    "ai"
  ],
  "author": "munroe153",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munroe153/OvO-Chat.git"
  },
  "homepage": "https://github.com/munroe153/OvO-Chat#readme",
  "bugs": {
    "url": "https://github.com/munroe153/OvO-Chat/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.1"
  }
}
